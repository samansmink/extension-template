# name: ${FILE_PATH}
# description: ${DESCRIPTION}
# group: [sf1]

# TPC-DS SF1 generated locally with dsdgen and written to Hive tables in the local Glue (moto) + S3 (MinIO) with CTAS.
# The fact tables are partitioned by their date key (as hive-testbench and spark-sql-perf do), the dimension tables
# are unpartitioned. The local tables are dropped after the load, so the queries read the Glue tables; the cache only
# keeps a marker table. The load skips tables that already exist in Glue: rebuild the fixture to change the data.
#
# The load needs a build without assertions (make release): the fact tables have rows with a NULL date key, and
# writing a partition with a NULL value more than one batch at a time trips a D_ASSERT in DuckDB's partitioned copy
# (PartitionedCopyBatchState::SetValues compares the partition values, and comparing NULL Values throws). Reproduces
# without Glue:
#   COPY (SELECT range AS id, CASE WHEN range % 2 = 0 THEN NULL ELSE range % 3 END AS k, repeat('x', 200) AS payload
#         FROM range(3000000)) TO 'out' (FORMAT parquet, PARTITION_BY (k));

require parquet

require httpfs

require glue

require tpcds

cache glue_tpcds_sf1.duckdb

load
CALL dsdgen(sf=1);
CREATE SECRET (
    TYPE S3,
    KEY_ID 'minio',
    SECRET 'minio123',
    REGION 'us-east-1',
    ENDPOINT 'localhost:9100',
    USE_SSL false,
    URL_STYLE 'path'
);
ATTACH '123456789012' AS my_datalake (
    TYPE glue,
    ENDPOINT 'http://localhost:5555',
    DEFAULT_LOCATION 's3://glue-test/warehouse/benchmark'
);
CREATE SCHEMA IF NOT EXISTS my_datalake.bench_tpcds_sf1;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1.store_sales PARTITIONED BY (ss_sold_date_sk) AS SELECT * FROM store_sales;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1.store_returns PARTITIONED BY (sr_returned_date_sk) AS SELECT * FROM store_returns;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1.catalog_sales PARTITIONED BY (cs_sold_date_sk) AS SELECT * FROM catalog_sales;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1.catalog_returns PARTITIONED BY (cr_returned_date_sk) AS SELECT * FROM catalog_returns;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1.web_sales PARTITIONED BY (ws_sold_date_sk) AS SELECT * FROM web_sales;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1.web_returns PARTITIONED BY (wr_returned_date_sk) AS SELECT * FROM web_returns;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1.inventory PARTITIONED BY (inv_date_sk) AS SELECT * FROM inventory;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1.call_center AS SELECT * FROM call_center;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1.catalog_page AS SELECT * FROM catalog_page;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1.customer AS SELECT * FROM customer;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1.customer_address AS SELECT * FROM customer_address;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1.customer_demographics AS SELECT * FROM customer_demographics;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1.date_dim AS SELECT * FROM date_dim;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1.household_demographics AS SELECT * FROM household_demographics;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1.income_band AS SELECT * FROM income_band;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1.item AS SELECT * FROM item;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1.promotion AS SELECT * FROM promotion;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1.reason AS SELECT * FROM reason;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1.ship_mode AS SELECT * FROM ship_mode;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1.store AS SELECT * FROM store;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1.time_dim AS SELECT * FROM time_dim;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1.warehouse AS SELECT * FROM warehouse;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1.web_page AS SELECT * FROM web_page;
CREATE TABLE IF NOT EXISTS my_datalake.bench_tpcds_sf1.web_site AS SELECT * FROM web_site;
DROP TABLE store_sales;
DROP TABLE store_returns;
DROP TABLE catalog_sales;
DROP TABLE catalog_returns;
DROP TABLE web_sales;
DROP TABLE web_returns;
DROP TABLE inventory;
DROP TABLE call_center;
DROP TABLE catalog_page;
DROP TABLE customer;
DROP TABLE customer_address;
DROP TABLE customer_demographics;
DROP TABLE date_dim;
DROP TABLE household_demographics;
DROP TABLE income_band;
DROP TABLE item;
DROP TABLE promotion;
DROP TABLE reason;
DROP TABLE ship_mode;
DROP TABLE store;
DROP TABLE time_dim;
DROP TABLE warehouse;
DROP TABLE web_page;
DROP TABLE web_site;
CREATE TABLE glue_tpcds_sf1_loaded AS SELECT 1 AS loaded;
USE my_datalake.bench_tpcds_sf1;
SET enable_external_file_cache=false;

reload
CREATE SECRET (
    TYPE S3,
    KEY_ID 'minio',
    SECRET 'minio123',
    REGION 'us-east-1',
    ENDPOINT 'localhost:9100',
    USE_SSL false,
    URL_STYLE 'path'
);
ATTACH '123456789012' AS my_datalake (
    TYPE glue,
    ENDPOINT 'http://localhost:5555',
    DEFAULT_LOCATION 's3://glue-test/warehouse/benchmark'
);
USE my_datalake.bench_tpcds_sf1;
SET enable_external_file_cache=false;

name DSQ${QUERY_NUMBER_PADDED}
group tpcds_glue
subgroup sf1

run duckdb/extension/tpcds/dsdgen/queries/${QUERY_NUMBER_PADDED}.sql

result duckdb/extension/tpcds/dsdgen/answers/sf1/${QUERY_NUMBER_PADDED}.csv
