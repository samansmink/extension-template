# name: test/sql/delta/test_insert_delta.test
# description: test inserting into a table
# group: [delta]

require httpfs

require aws

require iceberg

require delta

require glue

statement ok
CREATE SECRET (
  TYPE S3,
  PROVIDER credential_chain,
  REGION 'eu-central-1',
  PROFILE 'personal'
);

statement ok
attach '984506134640' as my_datalake (
    TYPE glue
);

# One partition per INSERT: the delta extension (at e258571) rejects an insert that writes more than one file,
# which a statement spanning several partitions does (fixed upstream on branch fix-multi-partition-append)
statement ok
INSERT INTO my_datalake.default.delta_partitioned_table
VALUES (5, 10), (7, 10);

statement ok
INSERT INTO my_datalake.default.delta_partitioned_table
VALUES (6, 11), (8, 11);

query I
select count(*) > 0 from my_datalake.default.delta_partitioned_table where int_col > 5;
----
true

