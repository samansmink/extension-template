# name: test/sql/hive/ddl/alter_partition_sql/alter_table_rename_partition.test
# description: ALTER TABLE ... PARTITION (...) RENAME TO PARTITION (...) as SQL, through the glue_hive_ddl grammar
# group: [alter_partition_sql]

#              extension. Mirrors alter_partition/alter_table_rename_partition.test.

require httpfs

require aws

require glue

require-env DEFAULT_S3_LOCATION

statement ok
SET active_grammar_extensions = ['glue_hive_ddl'];

statement ok
CREATE SECRET (
  TYPE S3,
  PROVIDER credential_chain,
  REGION 'eu-central-1',
  PROFILE 'personal'
);

statement ok
attach '984506134640' as my_datalake (
    TYPE glue,
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.sql_orders_rename;

statement ok
CREATE TABLE my_datalake.default.sql_orders_rename (id INTEGER, amount DOUBLE, dt VARCHAR, country VARCHAR) PARTITIONED BY (dt, country);

statement ok
INSERT INTO my_datalake.default.sql_orders_rename VALUES
    (1, 10.0, '2014-05-14', 'IN'),
    (2, 20.0, '2014-05-16', 'IN');

#---------------------------------------------------------------------------
# ALTER TABLE orders PARTITION (dt = '2014-05-14', country = 'IN') RENAME TO PARTITION (dt = '2014-05-15', country = 'IN');
#---------------------------------------------------------------------------
statement ok
ALTER TABLE my_datalake.default.sql_orders_rename PARTITION (dt = '2014-05-14', country = 'IN') RENAME TO PARTITION (dt = '2014-05-15', country = 'IN');

query II
SELECT dt, country FROM glue_partitions('my_datalake.default.sql_orders_rename') ORDER BY dt;
----
2014-05-15	IN
2014-05-16	IN

# renaming changes the partition values only: the data stays where it is
query I
SELECT location FROM glue_partitions('my_datalake.default.sql_orders_rename') WHERE dt = '2014-05-15';
----
{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/sql_orders_rename/dt=2014-05-14/country=IN

# the partition values of the rows come from Glue, not from the directory name
query III
SELECT id, dt, country FROM my_datalake.default.sql_orders_rename ORDER BY id;
----
1	2014-05-15	IN
2	2014-05-16	IN

query I
SELECT count(*) FROM my_datalake.default.sql_orders_rename WHERE dt = '2014-05-14';
----
0

#---------------------------------------------------------------------------
# errors
#---------------------------------------------------------------------------
# the source partition must exist
statement error
ALTER TABLE my_datalake.default.sql_orders_rename PARTITION (dt = '2014-05-14', country = 'IN') RENAME TO PARTITION (dt = '2014-05-17', country = 'IN');
----
does not exist

# the target partition must not exist
statement error
ALTER TABLE my_datalake.default.sql_orders_rename PARTITION (dt = '2014-05-15', country = 'IN') RENAME TO PARTITION (dt = '2014-05-16', country = 'IN');
----
already exists

# RENAME PARTITION does not rename partition columns
statement error
ALTER TABLE my_datalake.default.sql_orders_rename PARTITION (dt = '2014-05-15', country = 'IN') RENAME TO PARTITION (day = '2014-05-15', country = 'IN');
----

# both specs must be complete
statement error
ALTER TABLE my_datalake.default.sql_orders_rename PARTITION (dt = '2014-05-15') RENAME TO PARTITION (dt = '2014-05-18');
----

statement ok
attach '984506134640' as verify_datalake (
    TYPE glue,
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

query II
SELECT dt, country FROM glue_partitions('verify_datalake.default.sql_orders_rename') ORDER BY dt;
----
2014-05-15	IN
2014-05-16	IN

statement ok
DROP TABLE my_datalake.default.sql_orders_rename;
