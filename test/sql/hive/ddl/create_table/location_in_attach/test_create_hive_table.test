# name: test/sql/hive/ddl/create_table/location_in_attach/test_create_hive_table.test
# description: test creating a hive table
# group: [location_in_attach]

require httpfs

require aws

require glue

require-env DEFAULT_S3_LOCATION

statement ok
CREATE SECRET (
  TYPE S3,
  PROVIDER credential_chain,
  REGION 'eu-central-1',
  PROFILE 'personal'
);

statement ok
attach '984506134640' as my_datalake (
    TYPE glue,
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
SHOW ALL TABLES;


statement ok
DROP TABLE IF EXISTS my_datalake.default.hive_table;

statement ok
CREATE TABLE IF NOT EXISTS my_datalake.default.hive_table
(int_col integer, variant_col VARIANT, timestamp_col TIMESTAMP) WITH (type = 'HIVE');

query I
select distinct table_name from information_schema.columns where table_name = 'hive_table';
----
hive_table

# the table location in Glue
query I
SELECT location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/hive_table' FROM glue_get_table_response('my_datalake.default.hive_table');
----
true

mode skip

# We are not inserting into hive tables yet.
statement ok
insert into my_datalake.default.hive_table values (1, 5::VARIANT, now());


