# name: test/sql/hive/ddl/alter_column/alter_table_add_column.test
# description: ALTER TABLE ADD COLUMN on a Hive table registered in Glue
# group: [alter_column]

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.ddl_add_column;

statement ok
CREATE TABLE my_datalake.default.ddl_add_column (id INTEGER, name VARCHAR);

query II
SELECT column_name, data_type FROM duckdb_columns() WHERE database_name = 'my_datalake' AND table_name = 'ddl_add_column' ORDER BY column_index;
----
id	INTEGER
name	VARCHAR

statement ok
ALTER TABLE my_datalake.default.ddl_add_column ADD COLUMN score DOUBLE;

# the new column is appended after the existing ones
query II
SELECT column_name, data_type FROM duckdb_columns() WHERE database_name = 'my_datalake' AND table_name = 'ddl_add_column' ORDER BY column_index;
----
id	INTEGER
name	VARCHAR
score	DOUBLE

statement ok
ALTER TABLE my_datalake.default.ddl_add_column ADD COLUMN IF NOT EXISTS score DOUBLE;

# adding an existing column without IF NOT EXISTS is an error
statement error
ALTER TABLE my_datalake.default.ddl_add_column ADD COLUMN score DOUBLE;
----

# a second attach sees the change, it is stored in Glue and not only in the cached entry
statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake_2 (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

query II
SELECT column_name, data_type FROM duckdb_columns() WHERE database_name = 'my_datalake_2' AND table_name = 'ddl_add_column' ORDER BY column_index;
----
id	INTEGER
name	VARCHAR
score	DOUBLE

statement ok
DROP TABLE my_datalake.default.ddl_add_column;
