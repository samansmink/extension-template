# name: test/sql/hive/ddl/alter_column/alter_table_alter_column.test
# description: ALTER TABLE ALTER COLUMN TYPE on a Hive table registered in Glue
# group: [alter_column]

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.ddl_alter_column;

statement ok
CREATE TABLE my_datalake.default.ddl_alter_column (id INTEGER, price FLOAT, label VARCHAR);

# widening changes, the ones Hive can read back from existing parquet files
statement ok
ALTER TABLE my_datalake.default.ddl_alter_column ALTER COLUMN id TYPE BIGINT;

statement ok
ALTER TABLE my_datalake.default.ddl_alter_column ALTER COLUMN price TYPE DOUBLE;

query II
SELECT column_name, data_type FROM duckdb_columns() WHERE database_name = 'my_datalake' AND table_name = 'ddl_alter_column' ORDER BY column_index;
----
id	BIGINT
price	DOUBLE
label	VARCHAR

# narrowing is not allowed
statement error
ALTER TABLE my_datalake.default.ddl_alter_column ALTER COLUMN id TYPE INTEGER;
----

# an unknown column is an error
statement error
ALTER TABLE my_datalake.default.ddl_alter_column ALTER COLUMN missing TYPE BIGINT;
----

# a second attach sees the change, it is stored in Glue and not only in the cached entry
statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake_2 (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

query II
SELECT column_name, data_type FROM duckdb_columns() WHERE database_name = 'my_datalake_2' AND table_name = 'ddl_alter_column' ORDER BY column_index;
----
id	BIGINT
price	DOUBLE
label	VARCHAR

statement ok
DROP TABLE my_datalake.default.ddl_alter_column;
