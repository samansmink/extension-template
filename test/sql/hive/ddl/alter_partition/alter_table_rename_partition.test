# name: test/sql/hive/ddl/alter_partition/alter_table_rename_partition.test
# description: ALTER TABLE PARTITION (...) RENAME TO PARTITION (...) for Hive tables in Glue, following the examples
# group: [alter_partition]

#              in the Athena ALTER TABLE RENAME PARTITION documentation. DuckDB has no RENAME PARTITION syntax, the
#              statement is glue_rename_partition(table, partition_spec, new_partition_spec)

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.orders_rename;

statement ok
CREATE TABLE my_datalake.default.orders_rename (id INTEGER, amount DOUBLE, dt VARCHAR, country VARCHAR) PARTITIONED BY (dt, country);

statement ok
INSERT INTO my_datalake.default.orders_rename VALUES
    (1, 10.0, '2014-05-14', 'IN'),
    (2, 20.0, '2014-05-16', 'IN');

#---------------------------------------------------------------------------
# ALTER TABLE orders PARTITION (dt = '2014-05-14', country = 'IN') RENAME TO PARTITION (dt = '2014-05-15', country = 'IN');
#---------------------------------------------------------------------------
statement ok
CALL glue_rename_partition('my_datalake.default.orders_rename', {dt: '2014-05-14', country: 'IN'}, {dt: '2014-05-15', country: 'IN'});

query II
SELECT dt, country FROM glue_partitions('my_datalake.default.orders_rename') ORDER BY dt;
----
2014-05-15	IN
2014-05-16	IN

# renaming changes the partition values only: the data stays where it is (the table is external)
query I
SELECT location FROM glue_partitions('my_datalake.default.orders_rename') WHERE dt = '2014-05-15';
----
{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/orders_rename/dt=2014-05-14/country=IN

# the partition values of the rows come from Glue, not from the directory name
query III
SELECT id, dt, country FROM my_datalake.default.orders_rename ORDER BY id;
----
1	2014-05-15	IN
2	2014-05-16	IN

query I
SELECT id FROM my_datalake.default.orders_rename WHERE dt = '2014-05-15';
----
1

query I
SELECT count(*) FROM my_datalake.default.orders_rename WHERE dt = '2014-05-14';
----
0

#---------------------------------------------------------------------------
# errors
#---------------------------------------------------------------------------
# the source partition must exist
statement error
CALL glue_rename_partition('my_datalake.default.orders_rename', {dt: '2014-05-14', country: 'IN'}, {dt: '2014-05-17', country: 'IN'});
----
does not exist

# the target partition must not exist
statement error
CALL glue_rename_partition('my_datalake.default.orders_rename', {dt: '2014-05-15', country: 'IN'}, {dt: '2014-05-16', country: 'IN'});
----
already exists

# RENAME PARTITION does not rename partition columns
statement error
CALL glue_rename_partition('my_datalake.default.orders_rename', {dt: '2014-05-15', country: 'IN'}, {day: '2014-05-15', country: 'IN'});
----

# the second attach sees the renamed partition
statement ok
attach '{GLUE_CATALOG_ID}' as verify_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

query II
SELECT dt, country FROM glue_partitions('verify_datalake.default.orders_rename') ORDER BY dt;
----
2014-05-15	IN
2014-05-16	IN

statement ok
DROP TABLE my_datalake.default.orders_rename;
