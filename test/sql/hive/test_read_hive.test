# name: test/sql/hive/test_read_hive.test
# description: test creating a hive table
# group: [hive]

require httpfs

require aws

require glue

statement ok
CREATE SECRET (
  TYPE S3,
  PROVIDER credential_chain,
  REGION 'eu-central-1',
  PROFILE 'personal'
);

statement ok
attach '984506134640' as my_datalake (
    TYPE glue
);

query I
SELECT * FROM my_datalake.default.hive_table_2;
----
1
2
3
4

query II
SELECT * FROM my_datalake.default.hive_partitioned_table order by all;
----
1	1
2	2
3	1
4	2
