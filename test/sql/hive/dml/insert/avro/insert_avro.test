# name: test/sql/hive/dml/insert/avro/insert_avro.test
# description: CREATE TABLE ... WITH (format = 'avro') in Glue, INSERT writing avro files, reads through the catalog
#              and through hive_scan(format := 'avro')
# group: [avro]

require httpfs

require aws

require avro

require glue

require-env DEFAULT_S3_LOCATION

statement ok
CREATE SECRET (
  TYPE S3,
  PROVIDER credential_chain,
  REGION 'eu-central-1',
  PROFILE 'personal'
);

statement ok
attach '984506134640' as my_datalake (
    TYPE glue,
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.ins_avro;

statement ok
DROP TABLE IF EXISTS my_datalake.default.ins_avro_plain;

#---------------------------------------------------------------------------
# a partitioned avro table
#---------------------------------------------------------------------------
statement ok
CREATE TABLE my_datalake.default.ins_avro (flight VARCHAR, delay INTEGER, year INTEGER) PARTITIONED BY (year) WITH (format = 'avro');

query III
SELECT serde_library, parameters['classification'], columns[1].type FROM glue_get_table_response('my_datalake.default.ins_avro');
----
org.apache.hadoop.hive.serde2.avro.AvroSerDe	avro	string

statement ok
INSERT INTO my_datalake.default.ins_avro VALUES
    ('AA4', 3, 1993),
    ('AA3', 12, 1999),
    ('AA1', 5, 2007),
    ('AA2', 0, 2015);

# a second insert appends a file to an existing partition and adds a new one
statement ok
INSERT INTO my_datalake.default.ins_avro VALUES ('AA5', 7, 2015), ('AA6', 1, 2020);

# the files are avro container files, one directory per partition, without the partition column
query I
SELECT count(*) FROM glob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/ins_avro/year=2015/*.avro');
----
2

query II
SELECT flight, delay FROM read_avro('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/ins_avro/year=1993/*.avro');
----
AA4	3

query II
SELECT year, count(*) FROM glue_partitions('my_datalake.default.ins_avro') GROUP BY year ORDER BY year;
----
1993	1
1999	1
2007	1
2015	1
2020	1

query III
SELECT flight, delay, year FROM my_datalake.default.ins_avro ORDER BY year, flight;
----
AA4	3	1993
AA3	12	1999
AA1	5	2007
AA2	0	2015
AA5	7	2015
AA6	1	2020

query I
SELECT flight FROM my_datalake.default.ins_avro WHERE year = 2015 ORDER BY flight;
----
AA2
AA5

#---------------------------------------------------------------------------
# an unpartitioned avro table, with a column added after the first insert
#---------------------------------------------------------------------------
statement ok
CREATE TABLE my_datalake.default.ins_avro_plain (id INTEGER, name VARCHAR) WITH (format = 'avro');

statement ok
INSERT INTO my_datalake.default.ins_avro_plain VALUES (1, 'a'), (2, 'b');

statement ok
ALTER TABLE my_datalake.default.ins_avro_plain ADD COLUMN score DOUBLE;

statement ok
INSERT INTO my_datalake.default.ins_avro_plain VALUES (3, 'c', 3.5);

query III
SELECT id, name, score FROM my_datalake.default.ins_avro_plain ORDER BY id;
----
1	a	NULL
2	b	NULL
3	c	3.5

#---------------------------------------------------------------------------
# the same data through hive_scan(), without the catalog
#---------------------------------------------------------------------------
statement ok
DETACH my_datalake;

query III
SELECT flight, delay, year FROM hive_scan('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/ins_avro', format := 'avro',
    schema := {flight: 'VARCHAR', delay: 'INTEGER', year: 'INTEGER'},
    partitions := [{year: 1993}, {year: 2015}, {year: 2020}])
ORDER BY year, flight;
----
AA4	3	1993
AA2	0	2015
AA5	7	2015
AA6	1	2020

query III
SELECT id, name, score FROM hive_scan('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/ins_avro_plain', format := 'avro',
    schema := {id: 'INTEGER', name: 'VARCHAR', score: 'DOUBLE'})
ORDER BY id;
----
1	a	NULL
2	b	NULL
3	c	3.5

statement ok
attach '984506134640' as my_datalake (
    TYPE glue,
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE my_datalake.default.ins_avro;

statement ok
DROP TABLE my_datalake.default.ins_avro_plain;
