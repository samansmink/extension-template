# name: test/sql/hive/dml/insert_into.test
# description: INSERT INTO Hive tables in Glue, following the examples in the Athena INSERT INTO documentation
# group: [dml]

require httpfs

require aws

require glue

require-env DEFAULT_S3_LOCATION

statement ok
CREATE SECRET (
  TYPE S3,
  PROVIDER credential_chain,
  REGION 'eu-central-1',
  PROFILE 'personal'
);

statement ok
attach '984506134640' as my_datalake (
    TYPE glue,
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.dml_vancouver_pageviews;

statement ok
DROP TABLE IF EXISTS my_datalake.default.dml_canada_pageviews;

statement ok
DROP TABLE IF EXISTS my_datalake.default.dml_canada_july_pageviews;

statement ok
DROP TABLE IF EXISTS my_datalake.default.dml_cities_world;

statement ok
DROP TABLE IF EXISTS my_datalake.default.dml_cities_usa;

statement ok
DROP TABLE IF EXISTS my_datalake.default.dml_cities;

statement ok
DROP TABLE IF EXISTS my_datalake.default.dml_cities_by_state;

#---------------------------------------------------------------------------
# INSERT INTO ... SELECT
#---------------------------------------------------------------------------
# "date" is a reserved word in Athena and is quoted, as the docs recommend
statement ok
CREATE TABLE my_datalake.default.dml_vancouver_pageviews ("date" DATE, page VARCHAR, views BIGINT);

statement ok
INSERT INTO my_datalake.default.dml_vancouver_pageviews VALUES
    ('2019-06-30', 'home', 5),
    ('2019-07-01', 'home', 7),
    ('2019-07-15', 'about', 2),
    ('2019-07-31', 'home', 9),
    ('2019-08-01', 'about', 3);

statement ok
CREATE TABLE my_datalake.default.dml_canada_pageviews ("date" DATE, page VARCHAR, views BIGINT);

# select all rows of one table and insert them into another
statement ok
INSERT INTO my_datalake.default.dml_canada_pageviews
SELECT *
FROM my_datalake.default.dml_vancouver_pageviews;

query II
SELECT count(*), sum(views) FROM my_datalake.default.dml_canada_pageviews;
----
5	26

statement ok
CREATE TABLE my_datalake.default.dml_canada_july_pageviews ("date" DATE, page VARCHAR, views BIGINT);

# select a date range and insert it
statement ok
INSERT INTO my_datalake.default.dml_canada_july_pageviews
SELECT *
FROM my_datalake.default.dml_vancouver_pageviews
WHERE date
    BETWEEN date '2019-07-01'
        AND '2019-07-31';

query III
SELECT "date", page, views FROM my_datalake.default.dml_canada_july_pageviews ORDER BY "date";
----
2019-07-01	home	7
2019-07-15	about	2
2019-07-31	home	9

# select a subset of the columns into named columns of the destination
statement ok
CREATE TABLE my_datalake.default.dml_cities_world (city VARCHAR, state VARCHAR, country VARCHAR);

statement ok
INSERT INTO my_datalake.default.dml_cities_world VALUES ('Seattle', 'WA', 'usa'), ('Vancouver', 'BC', 'canada'), ('Portland', 'OR', 'usa');

statement ok
CREATE TABLE my_datalake.default.dml_cities_usa (city VARCHAR, state VARCHAR);

statement ok
INSERT INTO my_datalake.default.dml_cities_usa (city,state)
SELECT city,state
FROM my_datalake.default.dml_cities_world
    WHERE country='usa';

query II
SELECT * FROM my_datalake.default.dml_cities_usa ORDER BY city;
----
Portland	OR
Seattle	WA

#---------------------------------------------------------------------------
# INSERT INTO ... VALUES
#---------------------------------------------------------------------------
statement ok
CREATE TABLE my_datalake.default.dml_cities (id INTEGER, city VARCHAR, state VARCHAR, state_motto VARCHAR);

# a single row with every column specified
statement ok
INSERT INTO my_datalake.default.dml_cities
VALUES (1,'Lansing','MI','Si quaeris peninsulam amoenam circumspice');

# two rows at once (every INSERT writes a new file, the rows are appended)
statement ok
INSERT INTO my_datalake.default.dml_cities
VALUES (1,'Lansing','MI','Si quaeris peninsulam amoenam circumspice'),
       (3,'Boise','ID','Esto perpetua');

query IIII
SELECT * FROM my_datalake.default.dml_cities ORDER BY id, city;
----
1	Lansing	MI	Si quaeris peninsulam amoenam circumspice
1	Lansing	MI	Si quaeris peninsulam amoenam circumspice
3	Boise	ID	Esto perpetua

# columns that are not mentioned become NULL (Athena requires every column)
statement ok
INSERT INTO my_datalake.default.dml_cities (id, city) VALUES (4, 'Austin');

# values are cast to the column types (Athena requires the types to match precisely)
statement ok
INSERT INTO my_datalake.default.dml_cities VALUES ('5', 'Denver', 'CO', 'Nil sine numine');

query IIII
SELECT id, city, state, state_motto FROM my_datalake.default.dml_cities WHERE id >= 4 ORDER BY id;
----
4	Austin	NULL	NULL
5	Denver	CO	Nil sine numine

# the number of values must match the number of columns
statement error
INSERT INTO my_datalake.default.dml_cities VALUES (6, 'Boston');
----

statement error
INSERT INTO my_datalake.default.dml_cities (id, city) VALUES (6, 'Boston', 'MA');
----

#---------------------------------------------------------------------------
# partitioned destination: the partition column is the last column of the projection
#---------------------------------------------------------------------------
statement ok
CREATE TABLE my_datalake.default.dml_cities_by_state (id INTEGER, city VARCHAR, state VARCHAR) PARTITIONED BY (state);

statement ok
INSERT INTO my_datalake.default.dml_cities_by_state
SELECT id, city, state
FROM my_datalake.default.dml_cities
WHERE state IS NOT NULL;

# with a column list the partition column can be anywhere in the list
statement ok
INSERT INTO my_datalake.default.dml_cities_by_state (state, id, city) VALUES ('WA', 6, 'Seattle');

query II
SELECT state, count(*) FROM my_datalake.default.dml_cities_by_state GROUP BY state ORDER BY state;
----
CO	1
ID	1
MI	2
WA	1

query II
SELECT id, city FROM my_datalake.default.dml_cities_by_state WHERE state = 'MI' ORDER BY id;
----
1	Lansing
1	Lansing

# the partitions were registered in Glue: a fresh attach sees them
statement ok
attach '984506134640' as verify_datalake (
    TYPE glue,
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

query II
SELECT state, count(*) FROM verify_datalake.default.dml_cities_by_state GROUP BY state ORDER BY state;
----
CO	1
ID	1
MI	2
WA	1

# the source has more columns than the destination
statement error
INSERT INTO my_datalake.default.dml_cities_by_state SELECT * FROM my_datalake.default.dml_cities;
----

#---------------------------------------------------------------------------
# not supported
#---------------------------------------------------------------------------
statement error
INSERT INTO my_datalake.default.dml_cities VALUES (7, 'Reno', 'NV', 'All for our country') RETURNING id;
----
RETURNING clause not yet supported

statement error
INSERT INTO my_datalake.default.dml_cities VALUES (7, 'Reno', 'NV', 'All for our country') ON CONFLICT DO NOTHING;
----

statement error
INSERT OR REPLACE INTO my_datalake.default.dml_cities VALUES (7, 'Reno', 'NV', 'All for our country');
----

statement ok
DROP TABLE my_datalake.default.dml_vancouver_pageviews;

statement ok
DROP TABLE my_datalake.default.dml_canada_pageviews;

statement ok
DROP TABLE my_datalake.default.dml_canada_july_pageviews;

statement ok
DROP TABLE my_datalake.default.dml_cities_world;

statement ok
DROP TABLE my_datalake.default.dml_cities_usa;

statement ok
DROP TABLE my_datalake.default.dml_cities;

statement ok
DROP TABLE my_datalake.default.dml_cities_by_state;
