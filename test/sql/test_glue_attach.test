# name: test/sql/test_glue_attach.test
# description: test glue connect
# group: [sql]

require httpfs

require aws

require glue

require-env DEFAULT_S3_LOCATION

statement ok
CREATE SECRET (
  TYPE S3,
  PROVIDER credential_chain,
  REGION 'eu-central-1',
  PROFILE 'personal'
);

statement ok
attach '984506134640' as my_datalake (
    TYPE GLUE,
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
SHOW ALL TABLES

statement ok
select * from information_schema.columns;

query I
select tags['table_type'] FROM duckdb_tables() where database_name = 'my_datalake' GROUP BY ALL ORDER BY ALL;
----
DELTA
HIVE
ICEBERG
